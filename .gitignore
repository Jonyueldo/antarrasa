# ==============================================================================
# Git Ignore AntarRasa
# ==============================================================================

# File Konfigurasi Lokal (berisi kredensial; salin dari config/database.example.php)
config/database.php

# Unggahan pengguna (bukti bayar) tidak di-commit; hanya aturan keamanan foldernya
assets/uploads/bukti/*
!assets/uploads/bukti/.htaccess
assets/uploads/menu/*
!assets/uploads/menu/.htaccess

# File Log & Temp
*.log
error_log
.tmp
*.tmp

# Direktori Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# File Sistem Operasi
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Arsip
*.zip
*.tar.gz
*.rar
